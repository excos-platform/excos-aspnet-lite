<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    <PackageReference Include="Yarn.MSBuild" Version="1.22.19" />
  </ItemGroup>

  <!-- Include only index.html initially, app.js will be added after build -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="AssignTargetPaths">
    <Exec Command="yarn install --frozen-lockfile" WorkingDirectory="ClientApp" />
    <Exec Command="yarn build" WorkingDirectory="ClientApp" />
    
    <!-- Add the generated files to EmbeddedResource after they're created -->
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\app.js" />
      <!-- Only include source maps in Debug builds -->
      <EmbeddedResource Include="wwwroot\app.js.map" Condition="'$(Configuration)' == 'Debug'" />
      <EmbeddedResource Include="wwwroot\app.js.LICENSE.txt" Condition="Exists('wwwroot\app.js.LICENSE.txt')" />
    </ItemGroup>
  </Target>

</Project>
